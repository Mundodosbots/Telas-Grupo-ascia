# ---------- Banco ----------
POSTGRES_USER=painel
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=painel
DATABASE_URL=postgres://painel:troque-esta-senha@localhost:5432/painel

# ---------- App ----------
PORT=3000
# Gere com: bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
# true quando estiver atrás de HTTPS (produção com domínio)
COOKIE_SECURE=false
TZ_RELATORIOS=America/Sao_Paulo

# Usuário master criado no primeiro "db:seed" (só ele cria outras contas)
MASTER_NOME=Administrador
MASTER_EMAIL=admin@exemplo.com
MASTER_SENHA=troque-esta-senha

# ---------- Agente (OpenAI) ----------
# Sem chave, os atendimentos entram e ficam "pendentes" para classificação manual.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Abaixo desta confiança o atendimento vai para a fila "A revisar"
AGENTE_CONFIANCA_MINIMA=0.6

# ---------- Regras ----------
# Sem "conversa_id" no payload, uma nova atribuição do mesmo telefone (na mesma empresa)
# dentro desta janela é tratada como reatribuição do mesmo atendimento.
JANELA_REATRIBUICAO_DIAS=30

# ---------- Deploy ----------
# Porta exposta pelo container do app (sem HTTPS)
PORTA_PUBLICA=3000
# Domínio para HTTPS automático (perfil "https" do docker compose)
DOMINIO=painel.seudominio.com.br
